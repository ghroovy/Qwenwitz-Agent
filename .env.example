# Copy to .env and fill in your own values. .env is gitignored — never commit it.
HOI4_GAME_PATH=C:\Program Files (x86)\Steam\steamapps\common\Hearts of Iron IV
HOI4_WORKSPACE_PATH=C:\Users\YOU\Documents\Paradox Interactive\Hearts of Iron IV\mod\MyMod

# Reasoning model (recommended). Qwen/Qwen3.5-2B is the default; any cached
# Qwen model works, e.g. Qwen/Qwen2.5-0.5B-Instruct or Qwen/Qwen3.5-0.8B.
HOI4_AGENT_MODEL=Qwen/Qwen3.5-2B

# The local model layer runs fully offline; no API keys are used.
